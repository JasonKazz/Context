{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quantro proposed analysis contract",
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["url"], "properties": {"url": {"type": "string", "format": "uri", "maxLength": 4096}}
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "explanation", "evidence"],
      "properties": {
        "status": {"enum": ["candidate", "verified_passage", "inconclusive", "input_error"]},
        "explanation": {"type": "string"},
        "evidence": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["url", "kind", "text"],
          "properties": {"url": {"type": "string", "format": "uri"}, "kind": {"enum": ["indexed_text", "caption", "transcript", "media_comparison"]}, "text": {"type": "string"}}
        }}
      }
    }
  }
}
